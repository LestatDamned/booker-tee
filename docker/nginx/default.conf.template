limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=telegram:10m rate=20r/s;
map $request_method $statement_upload_limit_key {
    default "";
    POST $binary_remote_addr;
}
limit_req_zone $statement_upload_limit_key zone=statement_upload:10m rate=6r/m;
limit_conn_zone $statement_upload_limit_key zone=statement_upload_connections:10m;

log_format safe '$remote_addr [$time_iso8601] "$request_method $uri $server_protocol" '
                '$status $body_bytes_sent rt=$request_time urt=$upstream_response_time';

resolver 127.0.0.11 valid=10s ipv6=off;

upstream booker_tee_app {
    zone booker_tee_app 64k;
    server app:8000 resolve;
    keepalive 16;
}

server {
    access_log /var/log/nginx/access.log safe;
    listen 80;
    listen [::]:80;
    server_name ${BOOKER_TEE_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://${BOOKER_TEE_DOMAIN}$request_uri;
    }
}

server {
    access_log /var/log/nginx/access.log safe;
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${BOOKER_TEE_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${BOOKER_TEE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${BOOKER_TEE_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_tokens off;
    client_max_body_size 1m;
    client_body_timeout 30s;
    client_header_timeout 10s;
    keepalive_timeout 15s;
    send_timeout 60s;
    limit_req_status 429;
    limit_conn_status 429;

    proxy_http_version 1.1;
    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 120s;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location = /health/db {
        return 404;
    }

    location = /docs {
        return 404;
    }

    location = /redoc {
        return 404;
    }

    location = /openapi.json {
        return 404;
    }

    location ~ ^/api/v1/auth/(signup|email-verification-requests|email-verifications|login|password-reset-requests|password-resets)$ {
        limit_req zone=auth burst=10 nodelay;
        proxy_pass http://booker_tee_app;
    }

    location = /chat-integrations/telegram/webhook {
        limit_req zone=telegram burst=40 nodelay;
        proxy_pass http://booker_tee_app;
    }

    location = /api/v1/imports/documents {
        client_max_body_size 25m;
        limit_req zone=statement_upload burst=3 nodelay;
        limit_conn statement_upload_connections 2;
        proxy_pass http://booker_tee_app;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable, no-transform" always;
        proxy_pass http://booker_tee_app;
    }

    location / {
        proxy_pass http://booker_tee_app;
    }
}
