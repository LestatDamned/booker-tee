POSTGRES_DB=booker_tee
POSTGRES_USER=booker_tee
POSTGRES_PASSWORD=booker_tee
DATABASE_URL=postgresql+asyncpg://booker_tee:booker_tee@localhost:5433/booker_tee

BOOKER_TEE_APP_NAME=Booker Tee
BOOKER_TEE_ENVIRONMENT=local
BOOKER_TEE_DEBUG=true
BOOKER_TEE_REGISTRATION_MODE=open
BOOKER_TEE_PASSWORD_MIN_LENGTH=8
BOOKER_TEE_AUTH_SECRET_KEY=change-this-local-auth-secret
BOOKER_TEE_AUTH_PREVIOUS_SECRET_KEYS=
BOOKER_TEE_REFRESH_COOKIE_NAME=booker_refresh
BOOKER_TEE_SESSION_COOKIE_SECURE=false
BOOKER_TEE_SESSION_MAX_AGE_SECONDS=1209600
BOOKER_TEE_ACCESS_TOKEN_MAX_AGE_SECONDS=900
BOOKER_TEE_REFRESH_REUSE_GRACE_SECONDS=10
BOOKER_TEE_SESSION_IDLE_TIMEOUT_SECONDS=3600
BOOKER_TEE_SESSION_TOUCH_INTERVAL_SECONDS=300
BOOKER_TEE_IDENTITY_EMAIL_ENABLED=false
BOOKER_TEE_IDENTITY_EMAIL_FROM=
BOOKER_TEE_SMTP_HOST=
BOOKER_TEE_SMTP_PORT=587
BOOKER_TEE_SMTP_USERNAME=
BOOKER_TEE_SMTP_PASSWORD=
BOOKER_TEE_SMTP_STARTTLS=true
BOOKER_TEE_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
BOOKER_TEE_SECURITY_HEADERS_ENABLED=true
BOOKER_TEE_APP_PORT=8000
BOOKER_TEE_POSTGRES_PORT=5433
BOOKER_TEE_APP_CPUS=1.0
BOOKER_TEE_APP_MEMORY_LIMIT=1g
BOOKER_TEE_APP_PIDS_LIMIT=256
BOOKER_TEE_STATEMENT_UPLOAD_MAX_BYTES=20971520
BOOKER_TEE_STATEMENT_PDF_MAX_PAGES=200
BOOKER_TEE_STATEMENT_XLSX_MAX_SHEETS=20
BOOKER_TEE_STATEMENT_XLSX_MAX_ROWS_PER_SHEET=50000
BOOKER_TEE_STATEMENT_XLSX_MAX_COLUMNS_PER_SHEET=100
BOOKER_TEE_STATEMENT_XLSX_MAX_CELLS=1000000
BOOKER_TEE_STATEMENT_XLSX_MAX_UNCOMPRESSED_BYTES=104857600

# Chat integrations are disabled by default. For local Telegram bot development,
# use polling mode so the app does not need a public URL.
BOOKER_TEE_CHAT_INTEGRATIONS_ENABLED=false
BOOKER_TEE_TELEGRAM_BOT_TOKEN=
BOOKER_TEE_TELEGRAM_MODE=polling
BOOKER_TEE_TELEGRAM_WEBHOOK_SECRET=
BOOKER_TEE_TELEGRAM_POLLING_TIMEOUT_SECONDS=30
BOOKER_TEE_PUBLIC_BASE_URL=
