# PostgreSQL database name created by the container.
POSTGRES_DB=booker_tee
# PostgreSQL user created by the container.
POSTGRES_USER=booker_tee
# PostgreSQL password. Replace it with a strong secret outside local development.
POSTGRES_PASSWORD=booker_tee
# Async SQLAlchemy connection URL used by the application.
DATABASE_URL=postgresql+asyncpg://booker_tee:booker_tee@localhost:5433/booker_tee

# Application name shown in the UI and API metadata.
BOOKER_TEE_APP_NAME=Booker Tee
# Runtime profile: local, test, or production.
BOOKER_TEE_ENVIRONMENT=local
# Enables development diagnostics; keep false in production.
BOOKER_TEE_DEBUG=true
# Registration policy: open, invite_only, or closed.
BOOKER_TEE_REGISTRATION_MODE=open
# Minimum accepted user password length (8-1024 characters).
BOOKER_TEE_PASSWORD_MIN_LENGTH=8
# Secret used to sign authentication tokens. Use a random 32+ character value in production.
BOOKER_TEE_AUTH_SECRET_KEY=change-this-local-auth-secret
# Comma-separated old signing secrets accepted during key rotation.
BOOKER_TEE_AUTH_PREVIOUS_SECRET_KEYS=
# Browser cookie name used for the refresh token.
BOOKER_TEE_REFRESH_COOKIE_NAME=booker_refresh
# Sends the session cookie only over HTTPS; must be true in production.
BOOKER_TEE_SESSION_COOKIE_SECURE=false
# Maximum session lifetime in seconds (14 days by default).
BOOKER_TEE_SESSION_MAX_AGE_SECONDS=1209600
# Access token lifetime in seconds (15 minutes by default, maximum 1 hour).
BOOKER_TEE_ACCESS_TOKEN_MAX_AGE_SECONDS=900
# Grace period in seconds for concurrent reuse of a rotated refresh token.
BOOKER_TEE_REFRESH_REUSE_GRACE_SECONDS=10
# Ends a session after this many seconds without activity (12 hours by default).
BOOKER_TEE_SESSION_IDLE_TIMEOUT_SECONDS=43200
# Minimum interval in seconds between session activity updates in the database.
BOOKER_TEE_SESSION_TOUCH_INTERVAL_SECONDS=300

# Enables account verification and password-reset emails.
BOOKER_TEE_IDENTITY_EMAIL_ENABLED=false
# Sender address for account emails, for example Booker Tee <noreply@example.com>.
BOOKER_TEE_IDENTITY_EMAIL_FROM=
# SMTP server hostname used to send account emails.
BOOKER_TEE_SMTP_HOST=
# SMTP server port.
BOOKER_TEE_SMTP_PORT=587
# SMTP username; leave both username and password empty if authentication is not required.
BOOKER_TEE_SMTP_USERNAME=
# SMTP password; set it together with the username.
BOOKER_TEE_SMTP_PASSWORD=
# Upgrades the SMTP connection with STARTTLS.
BOOKER_TEE_SMTP_STARTTLS=true

# Comma-separated Host header values accepted by the application.
BOOKER_TEE_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
# Enables security response headers such as CSP and HSTS where applicable.
BOOKER_TEE_SECURITY_HEADERS_ENABLED=true
# Public hostname used by Nginx, TLS, and production validation; no scheme or path.
BOOKER_TEE_DOMAIN=localhost
# Email address passed to Let's Encrypt for certificate notices.
BOOKER_TEE_CERTBOT_EMAIL=
# Host port that exposes the application in local Compose.
BOOKER_TEE_APP_PORT=8000
# Host port that exposes PostgreSQL in local Compose.
BOOKER_TEE_POSTGRES_PORT=5433
# CPU limit for the application container in production Compose.
BOOKER_TEE_APP_CPUS=1.0
# Memory limit for the application container in production Compose.
BOOKER_TEE_APP_MEMORY_LIMIT=1g
# Process limit for the application container in production Compose.
BOOKER_TEE_APP_PIDS_LIMIT=256

# Hours to retain temporary uploaded source files before cleanup.
BOOKER_TEE_UPLOAD_RETENTION_HOURS=48
# Maximum uploaded statement size in bytes (20 MiB by default).
BOOKER_TEE_STATEMENT_UPLOAD_MAX_BYTES=20971520
# Maximum number of pages accepted from one PDF statement.
BOOKER_TEE_STATEMENT_PDF_MAX_PAGES=200
# Maximum total extracted characters accepted from one PDF.
BOOKER_TEE_STATEMENT_PDF_MAX_CHARACTERS=5000000
# Maximum number of tables accepted from one PDF.
BOOKER_TEE_STATEMENT_PDF_MAX_TABLES=2000
# Maximum total table cells accepted from one PDF.
BOOKER_TEE_STATEMENT_PDF_MAX_CELLS=500000
# Maximum serialized extraction result size in bytes (64 MiB by default).
BOOKER_TEE_STATEMENT_EXTRACTION_RESULT_MAX_BYTES=67108864
# Maximum wall-clock time in seconds allowed for one parser request.
BOOKER_TEE_STATEMENT_PARSER_WALL_TIMEOUT_SECONDS=60
# Maximum CPU time in seconds allowed for one parser request; cannot exceed the wall timeout.
BOOKER_TEE_STATEMENT_PARSER_CPU_SECONDS=45
# Maximum memory in bytes allowed for one parser request (512 MiB by default).
BOOKER_TEE_STATEMENT_PARSER_MEMORY_BYTES=536870912
# Unix socket used to communicate with the isolated parser; Compose sets this automatically.
BOOKER_TEE_STATEMENT_PARSER_SOCKET_PATH=
# Seconds to wait for the parser sidecar to become ready.
BOOKER_TEE_STATEMENT_PARSER_STARTUP_TIMEOUT_SECONDS=30
# Maximum number of worksheets accepted from one XLSX statement.
BOOKER_TEE_STATEMENT_XLSX_MAX_SHEETS=20
# Maximum number of rows accepted per XLSX worksheet.
BOOKER_TEE_STATEMENT_XLSX_MAX_ROWS_PER_SHEET=50000
# Maximum number of columns accepted per XLSX worksheet.
BOOKER_TEE_STATEMENT_XLSX_MAX_COLUMNS_PER_SHEET=100
# Maximum total cells accepted from one XLSX workbook.
BOOKER_TEE_STATEMENT_XLSX_MAX_CELLS=1000000
# Maximum total uncompressed XLSX content size in bytes (100 MiB by default).
BOOKER_TEE_STATEMENT_XLSX_MAX_UNCOMPRESSED_BYTES=104857600

# Enables chat integrations globally.
BOOKER_TEE_CHAT_INTEGRATIONS_ENABLED=false
# Telegram bot token issued by BotFather.
BOOKER_TEE_TELEGRAM_BOT_TOKEN=
# Telegram update delivery mode: polling for local development or webhook for production.
BOOKER_TEE_TELEGRAM_MODE=polling
# Secret Telegram sends with webhook requests; required in webhook mode.
BOOKER_TEE_TELEGRAM_WEBHOOK_SECRET=
# Optional HTTPS origin dedicated to receiving Telegram webhooks.
BOOKER_TEE_TELEGRAM_WEBHOOK_BASE_URL=
# Long-poll request timeout in seconds when polling mode is used.
BOOKER_TEE_TELEGRAM_POLLING_TIMEOUT_SECONDS=30
# Optional HTTP proxy used only for Telegram API traffic.
BOOKER_TEE_TELEGRAM_PROXY_URL=
# Public application origin used in email links and Telegram webhooks, for example https://finance.example.
BOOKER_TEE_PUBLIC_BASE_URL=
